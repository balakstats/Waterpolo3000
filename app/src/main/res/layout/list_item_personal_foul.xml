<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="com.example.waterpolo3000.utilities.ConstantsKt" />
<!--        <import type="android.view.View"/>-->

        <variable
            name="clickListener"
            type="android.view.View.OnClickListener" />

        <variable
            name="protocolPersonalFoul"
            type="com.example.waterpolo3000.data.ProtocolGameEventType" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="@{clickListener}">

        <TextView
            android:id="@+id/personal_foul_item_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingEnd="10sp"
            android:text="@{protocolPersonalFoul.timeString}"
            android:textStyle="bold"
            android:minEms="5"
            android:maxEms="5"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/personal_foul_item_white"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Zeit" />

        <TextView
            android:id="@+id/personal_foul_item_white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{protocolPersonalFoul.numberWhite}"
            android:textStyle="bold"
            android:minEms="2"
            android:maxEms="2"
            app:layout_constraintEnd_toStartOf="@+id/personal_foul_item_blue"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="W"
            android:paddingEnd="10sp"/>

        <TextView
            android:id="@+id/personal_foul_item_blue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{protocolPersonalFoul.numberBlue}"
            android:textStyle="bold"
            android:minEms="2"
            android:maxEms="2"
            app:layout_constraintEnd_toStartOf="@+id/personal_foul_item_type"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="B"
            android:paddingEnd="10sp"/>

        <TextView
            android:id="@+id/personal_foul_item_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@{protocolPersonalFoul.type}"
            android:textStyle="bold"
            android:minEms="2"
            android:maxEms="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Art"
            android:paddingEnd="10sp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>